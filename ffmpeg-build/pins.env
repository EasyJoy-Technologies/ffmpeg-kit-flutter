# Everything the FFmpeg builds depend on, pinned by commit. Build scripts verify each checkout
# against these values and stop on any mismatch.

# Upstream build scripts (ffmpeg-kit fork that produced com.antonkarpenko:ffmpeg-kit-min:2.2.1)
UPSTREAM_REPO=https://github.com/sk3llo/ffmpeg-kit.git
UPSTREAM_COMMIT_ANDROID_APPLE=984fa2dba93f93cd768dccb3033e6f175c46d3b5   # tag android-apple-8.1.2
UPSTREAM_COMMIT_WINDOWS=e8a5f4bda136bcf33597b085136bc7688b6a4e59         # tag windows-8.1.2

# FFmpeg source (arthenica mirror; same commit as the official n8.1.2 tag)
FFMPEG_REPO=https://github.com/arthenica/FFmpeg.git
FFMPEG_TAG=n8.1.2
FFMPEG_COMMIT=38b88335f99e76ed89ff3c93f877fdefce736c13

# Android-only dependency of the upstream scripts
CPU_FEATURES_REPO=https://github.com/arthenica/cpu_features
CPU_FEATURES_TAG=v0.8.0
CPU_FEATURES_COMMIT=936b9ab5515dead115606559502e3864958f7f6e

# Toolchains
ANDROID_NDK_VERSION=28.2.13676358     # same as the NiceNote app (flutter.ndkVersion)
ANDROID_API=24                        # = minSdk of the plugin and the app

# Java layer of the Android AAR: reused byte-for-byte from the published 2.2.1 package
BASE_AAR=android/libs/maven/com/antonkarpenko/ffmpeg-kit-min/2.2.1/ffmpeg-kit-min-2.2.1.aar
BASE_AAR_SHA256=bd5bd9f847b16d1f38f016e078b74ec578f04e728974a43e2e53b31820d3bb6f   # = Maven Central
